{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "sidebar",
  "homepage": "https://github.com/Kaori2499/sidebar",
  "items": [
    {
      "name": "sidebar",
      "title": "Sidebar",
      "description": "shadcn Base Nova sidebar with peek variant (transform-based edge hover) and full compound API.",
      "dependencies": [
        "@base-ui/react",
        "class-variance-authority",
        "cn",
        "lucide-react"
      ],
      "files": [
        {
          "path": "registry/ui/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        },
        {
          "path": "registry/ui/hooks/use-mobile.ts",
          "type": "registry:hook",
          "target": "hooks/use-mobile.ts"
        },
        {
          "path": "registry/ui/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        },
        {
          "path": "registry/ui/input.tsx",
          "type": "registry:ui",
          "target": "components/ui/input.tsx"
        },
        {
          "path": "registry/ui/separator.tsx",
          "type": "registry:ui",
          "target": "components/ui/separator.tsx"
        },
        {
          "path": "registry/ui/sheet.tsx",
          "type": "registry:ui",
          "target": "components/ui/sheet.tsx"
        },
        {
          "path": "registry/ui/skeleton.tsx",
          "type": "registry:ui",
          "target": "components/ui/skeleton.tsx"
        },
        {
          "path": "registry/ui/tooltip.tsx",
          "type": "registry:ui",
          "target": "components/ui/tooltip.tsx"
        },
        {
          "path": "registry/ui/sidebar.tsx",
          "type": "registry:ui",
          "target": "components/ui/sidebar.tsx"
        }
      ],
      "docs": "Import sidebar primitives from `@/components/ui/sidebar`. Requires Tailwind v4 and Base Nova theme tokens (`--sidebar-*` CSS variables). Add `@source` for `components/ui` so Tailwind emits utility classes used by the sidebar.",
      "type": "registry:ui"
    },
    {
      "name": "sidebar-playground",
